# Public hostname served by Traefik (must match examples/traefik/.env).
APP_DOMAIN=app.example.com

# PostgreSQL
POSTGRES_USER=fluxsend
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fluxsend

# MinIO (also used as the backend's access/secret key)
MINIO_ROOT_USER=fluxsend
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET_NAME=fluxsend

# Optional: public HTTPS endpoint for direct downloads (e.g. https://s3.app.example.com).
# Leave empty to stream downloads through the backend and keep MinIO private.
# Requires a DNS record and the commented Traefik labels in docker-compose.yaml.
MINIO_PUBLIC_ENDPOINT=
MINIO_REGION=us-east-1

# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# SMTP (port 587 STARTTLS)
MAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
